# This is Git's per-user configuration file.

# Note: [user] name/email is intentionally NOT tracked here (personal info).
# It lives in the untracked .gitconfig.local file next to this one (same
# directory as this config). If .gitconfig.local doesn't exist, git silently
# skips this include - no error - so re-cloning/syncing this repo elsewhere
# won't break, you'll just be prompted by git to set user.name/user.email
# the first time you commit. See .gitconfig.local.example for the format.
[include]
	path = .gitconfig.local

# Note: [safe] "directory" entries are intentionally NOT tracked here.
# They point at machine-specific local checkout paths and should be
# added locally per-machine (git will prompt/error and tell you how),
# not synced via dotfiles.

[core]
	editor = hx
	pager = delta
	# ~/ expansion is resolved per-machine (USERPROFILE on Windows, $HOME on
	# WSL/Linux), so this single tracked file covers both checkouts of this
	# bare repo without any machine-specific path.
	attributesFile = ~/.gitattributes_global

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	# base16 maps syntax colors to the terminal's ANSI palette, so delta
	# follows the WezTerm tokyonight_storm scheme instead of its own theme.
	syntax-theme = base16
	minus-style = syntax "#37222c"
	minus-emph-style = syntax "#713137"
	plus-style = syntax "#20303b"
	plus-emph-style = syntax "#2c5a66"
	line-numbers-minus-style = "#db4b4b"
	line-numbers-plus-style = "#449dab"
	line-numbers-zero-style = "#3b4261"

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default
