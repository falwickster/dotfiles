# Copy this file to ~/.azure-devops.local (same directory as
# .gitconfig.local) and replace the placeholder below with your Azure
# DevOps organization name(s) (e.g. the "contoso" in
# https://dev.azure.com/contoso).
#
# This file is NOT deployed by install-dotfiles.sh's bare-repo checkout
# and is never committed - it's read directly from $HOME by
# scripts/install-azure-devops-mcp.sh, the same way .gitconfig.local is
# read directly by git itself. Lines starting with # and blank lines are
# ignored.
#
# List one organization per line. Every org listed here gets its own
# Copilot MCP server (named "azure-devops-<org>"), registered
# simultaneously - no switching required, all orgs' tools are available
# at once. Re-run scripts/install-azure-devops-mcp.sh after adding an org
# here to register it.
your-first-ado-org-name
# your-second-ado-org-name
# your-third-ado-org-name
